rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to access their own activities
    // Since we're using Clerk (not Firebase Auth), we need to allow access
    // The API routes already verify Clerk authentication server-side
    match /users/{userId}/activities/{activityId} {
      // For development: Allow all reads and writes
      // In production, you should use Firebase Admin SDK on the server
      allow read, write: if true;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

